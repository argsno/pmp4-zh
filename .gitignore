# Python bytecode / cache
__pycache__/
*.pyc

# Derived EPUB extraction (regenerate by unzipping the .epub source).  No
# trailing slash: it may be a directory or, in a worktree, a symlink to the
# main checkout's extraction.
epub_extract

# Cover carries no translatable nodes at all — just the cover image — so its
# skeleton really is working residue from the extract step rather than data.
#
# Contents, Copyright, Index and Title_page used to be listed here too, as
# out-of-scope pages (spec §Out of Scope).  They are translated and tracked
# now: leaving them out meant the renderer skipped all four, and every link
# aimed at them from the zh and bilingual sites — chapter dropdown, top bar,
# bottom pager, landing table of contents — was dead.
translations/Cover/
